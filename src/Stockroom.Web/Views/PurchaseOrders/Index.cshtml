@model IReadOnlyList<PurchaseOrderRow>
@{ ViewData["Title"] = "Purchase orders"; }

<h1 class="h3 mb-3">Purchase orders</h1>

@* The Receive buttons aren't inside a form, so the anti-forgery token is placed
   here once and sent by jQuery as a request header. *@
@Html.AntiForgeryToken()

<div id="po-result" role="status" aria-live="polite"></div>
<div id="po-table" data-table-url="@Url.Action("Table")" data-receive-url="@Url.Action("Receive")">
    <partial name="_Table" model="Model" />
</div>

@section Scripts {
    <script src="~/js/purchase-orders.js" asp-append-version="true"></script>
}
