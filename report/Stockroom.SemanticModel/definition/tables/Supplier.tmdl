/// One row per supplier (source: view rpt.dim_supplier).
table Supplier

	column 'Supplier ID'
		dataType: int64
		isHidden
		isKey
		formatString: 0
		summarizeBy: none
		sourceColumn: supplier_id

	column Supplier
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column City
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column 'Is Active'
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: is_active

	partition Supplier = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database, [ConnectionTimeout = #duration(0, 0, 2, 0)]),
				    View = Source{[Schema = "rpt", Item = "dim_supplier"]}[Data],
				    Columns = Table.SelectColumns(View, {"supplier_id", "supplier_name", "city", "country", "is_active"})
				in
				    Columns

	annotation PBI_ResultType = Table

